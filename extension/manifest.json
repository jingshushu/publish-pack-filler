{
  "manifest_version": 3,
  "name": "全平台半自动发布助手",
  "short_name": "半自动发布助手",
  "version": "2.0.4",
  "description": "全平台半自动发布与飞书多维表直连助手：跨设备一键配置码激活、NAS未同步云端兜底、发布前统一警告变绿同步与四端数据导表归档",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://creator.xiaohongshu.com/*",
    "https://creator.douyin.com/*",
    "https://channels.weixin.qq.com/*",
    "https://member.bilibili.com/*",
    "https://cp.kuaishou.com/*",
    "https://mp.weixin.qq.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://weibo.com/*",
    "https://studio.youtube.com/*",
    "https://open.feishu.cn/*",
    "https://base-api.feishu.cn/*",
    "https://open.larksuite.com/*",
    "https://base-api.larksuite.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "全平台半自动发布助手 (v2.0.2)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://creator.xiaohongshu.com/*",
        "https://creator.douyin.com/*",
        "https://channels.weixin.qq.com/*",
        "https://member.bilibili.com/*",
        "https://cp.kuaishou.com/*",
        "https://mp.weixin.qq.com/*",
        "https://zhuanlan.zhihu.com/*",
        "https://weibo.com/*",
        "https://studio.youtube.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
