{
  "manifest_version": 3,
  "name": "全平台半自动发布助手",
  "short_name": "半自动发布助手",
  "version": "1.5.0",
  "description": "全平台半自动发布助手：支持飞书目录智能寻址与多端共享成品包，覆盖小红书、视频号、抖音、B站等平台封面比例自适应注入与拟人填表",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://creator.xiaohongshu.com/*",
    "https://creator.douyin.com/*",
    "https://channels.weixin.qq.com/*",
    "https://member.bilibili.com/*",
    "https://cp.kuaishou.com/*",
    "https://mp.weixin.qq.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://weibo.com/*",
    "https://studio.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "全平台半自动发布助手 (v1.5.0)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://creator.xiaohongshu.com/*",
        "https://creator.douyin.com/*",
        "https://channels.weixin.qq.com/*",
        "https://member.bilibili.com/*",
        "https://cp.kuaishou.com/*",
        "https://mp.weixin.qq.com/*",
        "https://zhuanlan.zhihu.com/*",
        "https://weibo.com/*",
        "https://studio.youtube.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
