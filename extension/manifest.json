{
  "manifest_version": 3,
  "name": "万物有数 · 多平台发布包填表助手",
  "short_name": "发布包助手",
  "version": "1.4.1",
  "description": "支持飞书发布表「本地作品目录 + 分发账号」智能寻址唤起 Finder 与发布页并透传成品包，兼容 PublishPack v1.0 JSON 与 Markdown，覆盖小红书、视频号、抖音、B站等平台安全预填与配图",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://creator.xiaohongshu.com/*",
    "https://creator.douyin.com/*",
    "https://channels.weixin.qq.com/*",
    "https://member.bilibili.com/*",
    "https://cp.kuaishou.com/*",
    "https://mp.weixin.qq.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://weibo.com/*",
    "https://studio.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "多平台发布包填表助手 (v1.4.1 · 飞书直连)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://creator.xiaohongshu.com/*",
        "https://creator.douyin.com/*",
        "https://channels.weixin.qq.com/*",
        "https://member.bilibili.com/*",
        "https://cp.kuaishou.com/*",
        "https://mp.weixin.qq.com/*",
        "https://zhuanlan.zhihu.com/*",
        "https://weibo.com/*",
        "https://studio.youtube.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
